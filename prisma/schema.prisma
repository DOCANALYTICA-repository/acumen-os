// Acumen event platform — local-first schema (SQLite).
// Swap provider to "postgresql" for deployment; JSON-ish fields are stored as strings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  passwordHash String
  phone        String   @default("")
  college      String   @default("")
  year         String   @default("")
  city         String?
  source       String?
  role         String   @default("PARTICIPANT") // PARTICIPANT | JUDGE | ADMIN
  createdAt    DateTime @default(now())

  membership  TeamMember?
  submissions Submission[]
  assignments JudgeAssignment[]
  scores      Score[]
}

model Team {
  id                String    @id @default(cuid())
  name              String    @unique
  inviteCode        String    @unique
  paymentScreenshot String?
  transactionId     String?
  paymentStatus     String    @default("UNPAID") // UNPAID | PAID | REJECTED
  disqualified      Boolean   @default(false)
  notes             String?
  lockedAt          DateTime?
  createdAt         DateTime  @default(now())

  members        TeamMember[]
  attempts       Attempt[]
  submissions    Submission[]
  qualifications Qualification[]
  assignments    JudgeAssignment[]
  scores         Score[]
  overrides      ResultOverride[]
  ventures       SimVenture[]
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String   @unique
  isLead   Boolean  @default(false)
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Round {
  id                  String    @id @default(cuid())
  order               Int       @unique
  name                String
  type                String // QUIZ | EXCEL | SUBMISSION | SIMULATION
  description         String    @default("")
  instructions        String    @default("")
  startsAt            DateTime?
  endsAt              DateTime?
  durationMinutes     Int? // quiz / excel timer
  weight              Float     @default(20)
  status              String    @default("DRAFT") // DRAFT | SCHEDULED | LIVE | CLOSED
  resultsPublished    Boolean   @default(false)
  restrictToQualified Boolean   @default(false)
  settings            String    @default("{}") // submission rules etc.
  briefFile           String?
  excelTemplate       String?
  excelAnswerKey      String    @default("[]") // [{cell,label,value,tolerance,marks}]

  questions      Question[]
  attempts       Attempt[]
  submissions    Submission[]
  criteria       RubricCriterion[]
  qualifications Qualification[]
  assignments    JudgeAssignment[]
  scores         Score[]
  overrides      ResultOverride[]
  economy        SimEconomy?
  liveQuiz       LiveQuiz?
}

model Question {
  id            String @id @default(cuid())
  roundId       String
  order         Int    @default(0)
  type          String // NUMBER (guesstimate) | SINGLE | MULTI | TRUEFALSE | SHORT
  text          String
  options       String @default("[]")
  answer        String // JSON: index, [indexes], true/false, or string
  marks         Float  @default(1) // live quiz: 1 mark = up to 1000 points
  negativeMarks Float  @default(0) // unused by the live quiz
  timeLimit     Int    @default(20) // live quiz: seconds to answer
  explanation   String @default("")

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)
}

/// Host-led live quiz session for a QUIZ round. Teams join (an Attempt row), the host moves everyone question by question.
model LiveQuiz {
  id           String    @id @default(cuid())
  roundId      String    @unique
  status       String    @default("LOBBY") // LOBBY | QUESTION | FINISHED
  currentIndex Int       @default(-1)
  questionIds  String    @default("[]") // play order, fixed when the lobby opens
  opensAt      DateTime? // answers accepted from here (after the get-ready countdown)
  endsAt       DateTime?
  updatedAt    DateTime  @updatedAt

  round   Round        @relation(fields: [roundId], references: [id], onDelete: Cascade)
  answers LiveAnswer[]
}

model LiveAnswer {
  id         String   @id @default(cuid())
  liveId     String
  questionId String
  teamId     String
  userId     String
  answer     String // JSON number (the team's guess)
  correct    Boolean // scored any points
  points     Int // 0-3 by % error
  streak     Int      @default(0) // unused
  ms         Int      @default(0) // unused
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  live LiveQuiz @relation(fields: [liveId], references: [id], onDelete: Cascade)

  @@unique([liveId, questionId, teamId])
}

model Attempt {
  id          String    @id @default(cuid())
  roundId     String
  teamId      String
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  answers     String    @default("{}")
  fileUrl     String?
  autoScore   Float?
  manualScore Float?
  tabSwitches Int       @default(0)

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)
  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([roundId, teamId])
}

model Submission {
  id           String   @id @default(cuid())
  roundId      String
  teamId       String
  uploadedById String
  files        String // JSON [{path,name,size,type}]
  links        String   @default("[]")
  title        String   @default("")
  summary      String   @default("")
  version      Int      @default(1)
  isLate       Boolean  @default(false)
  submittedAt  DateTime @default(now())

  round      Round @relation(fields: [roundId], references: [id], onDelete: Cascade)
  team       Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  uploadedBy User  @relation(fields: [uploadedById], references: [id])
}

model RubricCriterion {
  id       String  @id @default(cuid())
  roundId  String
  name     String
  maxMarks Float
  scores   Score[]

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)
}

model JudgeAssignment {
  id      String @id @default(cuid())
  roundId String
  teamId  String
  judgeId String

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)
  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  judge User  @relation(fields: [judgeId], references: [id], onDelete: Cascade)

  @@unique([roundId, teamId, judgeId])
}

model Score {
  id          String @id @default(cuid())
  roundId     String
  teamId      String
  judgeId     String
  criterionId String
  marks       Float
  comment     String @default("")

  round     Round           @relation(fields: [roundId], references: [id], onDelete: Cascade)
  team      Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  judge     User            @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  criterion RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([roundId, teamId, judgeId, criterionId])
}

model ResultOverride {
  roundId String
  teamId  String
  score   Float // percentage 0-100

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)
  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([roundId, teamId])
}

model Qualification {
  roundId String
  teamId  String

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)
  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([roundId, teamId])
}

model Asset {
  id         String   @id @default(cuid())
  title      String
  category   String   @default("General")
  filePath   String
  visibility String   @default("PUBLIC") // PUBLIC | PARTICIPANTS
  createdAt  DateTime @default(now())
}

model Announcement {
  id        String   @id @default(cuid())
  message   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Content {
  key   String @id
  value String
}

// ---------------- Simulation module (Startup Ecosystem round) ----------------
// One economy per SIMULATION round. All outcomes are computed server-side by src/lib/sim/engine.ts.

model SimEconomy {
  id           String    @id @default(cuid())
  roundId      String    @unique
  template     String    @default("ev-mobility")
  config       String // JSON EconomyConfig (industry, roles, cycles, finance, scoring)
  status       String    @default("SETUP") // SETUP | AUCTION | OPEN | PROCESSING | PAUSED | FINISHED
  currentCycle Int       @default(0) // year accepting decisions (1-based); 0 = not started
  cycleEndsAt  DateTime?
  pausedMs     Int? // time left in the decision window while PAUSED
  market       String    @default("{}") // JSON MarketState after the last processed cycle
  updatedAt    DateTime  @updatedAt

  round     Round         @relation(fields: [roundId], references: [id], onDelete: Cascade)
  ventures  SimVenture[]
  decisions SimDecision[]
  contracts SimContract[]
  messages  SimMessage[]
  events    SimEvent[]
  snapshots SimSnapshot[]
  lots      SimAuctionLot[]
}

/// Setup auction: one lot per business identity (role) and per resource. Teams bid from their base budget.
model SimAuctionLot {
  id          String    @id @default(cuid())
  economyId   String
  order       Int
  kind        String // IDENTITY | RESOURCE
  key         String // role key or resource key
  name        String
  description String    @default("")
  reserve     Float
  status      String    @default("PENDING") // PENDING | OPEN | SOLD | UNSOLD
  endsAt      DateTime?
  winnerId    String? // venture id
  price       Float?
  createdAt   DateTime  @default(now())

  economy SimEconomy @relation(fields: [economyId], references: [id], onDelete: Cascade)
  bids    SimBid[]
}

model SimBid {
  id        String   @id @default(cuid())
  lotId     String
  ventureId String
  amount    Float
  userId    String?
  createdAt DateTime @default(now())

  lot SimAuctionLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
}

model SimVenture {
  id        String   @id @default(cuid())
  economyId String
  teamId    String
  roleKey   String
  state     String   @default("{}") // JSON VentureState (cash, debt, capacity, quality, brand…)
  createdAt DateTime @default(now())

  economy   SimEconomy    @relation(fields: [economyId], references: [id], onDelete: Cascade)
  team      Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  decisions SimDecision[]
  sales     SimContract[] @relation("seller")
  purchases SimContract[] @relation("buyer")

  @@unique([economyId, teamId])
}

model SimDecision {
  id            String   @id @default(cuid())
  economyId     String
  ventureId     String
  cycle         Int
  data          String // JSON Decision
  submittedById String?
  updatedAt     DateTime @updatedAt

  economy SimEconomy @relation(fields: [economyId], references: [id], onDelete: Cascade)
  venture SimVenture @relation(fields: [ventureId], references: [id], onDelete: Cascade)

  @@unique([ventureId, cycle])
}

model SimContract {
  id          String    @id @default(cuid())
  economyId   String
  sellerId    String
  buyerId     String
  proposerId  String // venture id that proposed it
  kind        String    @default("SUPPLY") // SUPPLY | LICENSE | LOAN | MARKETING
  units       Float // supply: units per year
  unitPrice   Float // supply: price per unit · licence: yearly fee · loan: principal · alliance: yearly fee per partner
  ratePct     Float     @default(0) // loan interest % per year
  startCycle  Int
  cycles      Int
  status      String    @default("PROPOSED") // PROPOSED | ACTIVE | REJECTED | WITHDRAWN | COMPLETED
  note        String    @default("")
  delivered   Float     @default(0) // cumulative units delivered
  shortfall   Float     @default(0) // cumulative units not delivered
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  economy SimEconomy @relation(fields: [economyId], references: [id], onDelete: Cascade)
  seller  SimVenture @relation("seller", fields: [sellerId], references: [id], onDelete: Cascade)
  buyer   SimVenture @relation("buyer", fields: [buyerId], references: [id], onDelete: Cascade)
}

model SimMessage {
  id        String   @id @default(cuid())
  economyId String
  fromId    String? // venture id; null = organisers / system
  toId      String? // venture id; null = everyone
  body      String
  kind      String   @default("CHAT") // CHAT | INTEL | SYSTEM
  createdAt DateTime @default(now())

  economy SimEconomy @relation(fields: [economyId], references: [id], onDelete: Cascade)
}

model SimEvent {
  id          String   @id @default(cuid())
  economyId   String
  cycle       Int // applied when this cycle is processed; visible to teams once the cycle opens
  title       String
  description String   @default("")
  effects     String   @default("{}") // JSON EventEffects
  createdAt   DateTime @default(now())

  economy SimEconomy @relation(fields: [economyId], references: [id], onDelete: Cascade)
}

model SimSnapshot {
  id        String @id @default(cuid())
  economyId String
  cycle     Int
  ventureId String // venture id, or "MARKET" for the market report
  data      String // JSON VentureResult | MarketState

  economy SimEconomy @relation(fields: [economyId], references: [id], onDelete: Cascade)

  @@unique([economyId, cycle, ventureId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  detail    String   @default("")
  createdAt DateTime @default(now())
}
