# Copy to .env for local development. On Vercel, add the same names under Settings → Environment Variables.

# --- Database (Supabase → Project Settings → Database → Connection string) ---
# Pooled "Transaction" connection, port 6543. Keep ?pgbouncer=true&connection_limit=1 on the end.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct or "Session" connection, port 5432. Used only by `prisma db push`.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- File uploads (Supabase → Project Settings → API) ---
# Leave empty locally to store uploads in ./storage. Required on Vercel.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""          # secret: server only, never expose to the browser
SUPABASE_BUCKET="uploads"             # PRIVATE bucket; holds only the payment receipts attached at registration

# --- Sessions ---
# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# --- Staff sign-in codes by email (Brevo → SMTP & API → API keys) ---
# Leave empty locally: the code is printed in the server console instead.
BREVO_API_KEY=""                      # secret: server only
BREVO_SENDER_EMAIL=""                 # must be a sender verified in Brevo (Senders, domains & IPs)
BREVO_SENDER_NAME="Acumen"

# --- First setup of a deployed database only (npm run db:setup) ---
ADMIN_EMAIL=""
ADMIN_PASSWORD=""                     # 12+ characters

# Registration attempts allowed per network (IP) per hour. Default 20.
REGISTER_LIMIT_PER_HOUR=""
